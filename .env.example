OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# PDF / website answers (RAG)
CHAT_MODEL=llama3.2:3b

# Database answers (text-to-SQL). Also phrases the result rows into an answer.
SQL_MODEL=qwen2.5-coder:3b

CHROMA_DIR=
COLLECTION_NAME=ingested_documents

# Postgres credentials entered at ingest are cached here IN PLAINTEXT so the
# text-to-SQL path can reconnect at question time. Defaults to
# <CHROMA_DIR or ~>/.chatbot_fresh_store/db_connections.json — delete it to revoke.
# DB_CONN_FILE=
