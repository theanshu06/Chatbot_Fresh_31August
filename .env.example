OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# PDF / website answers (RAG)
CHAT_MODEL=llama3.2:3b

# Database answers (text-to-SQL). Result rows are phrased by CHAT_MODEL.
SQL_MODEL=qwen2.5-coder:3b

# Database ingest embeds only the schema + table card by default (seconds, not
# minutes). Set true to also embed row chunks — only used by the RAG fallback
# when SQL generation fails, and by the "Show ingested" view.
# EMBED_DB_ROWS=false
# DB_SAMPLE_ROWS=20

CHROMA_DIR=
COLLECTION_NAME=ingested_documents

# Postgres credentials entered at ingest are cached here IN PLAINTEXT so the
# text-to-SQL path can reconnect at question time. Defaults to
# <CHROMA_DIR or ~>/.chatbot_fresh_store/db_connections.json — delete it to revoke.
# DB_CONN_FILE=
